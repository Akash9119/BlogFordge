# ---------------------------------------------------------------------------
# Compose-level settings for the Oracle Cloud deployment.
#   cp .env.example .env      (on the server, then edit)
#
# This file configures the *edge* only. Application secrets stay in
# Backend/.env and ai-service/.env exactly as they do in development.
# ---------------------------------------------------------------------------

# The address Caddy serves on, and the one thing that decides TLS:
#
#   blog.example.com   → automatic Let's Encrypt certificate (needs a real DNS
#                        A record pointing at this VM, and port 80 reachable)
#   :80                → plain HTTP on the instance's public IP, no certificate
#
# Start with :80 to prove the stack is up, then switch to your domain — Caddy
# issues the certificate on the next `docker compose up -d`.
SITE_ADDRESS=:80

# Where Let's Encrypt sends expiry warnings. Ignored when SITE_ADDRESS is :80.
ACME_EMAIL=

# The browser-visible origin, used for the API's CORS allowlist.
#   https://blog.example.com   (domain)   or   http://<your-public-ip>  (IP)
PUBLIC_ORIGIN=http://localhost
