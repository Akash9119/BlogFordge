# --- Server ---
NODE_ENV=development
PORT=5000
# Number of reverse proxies in front of this API, not a boolean. 0 for a direct
# connection; 1 behind the Caddy container in docker-compose.yml (or nginx,
# Render, Railway). Trusting more hops than exist lets a client forge
# X-Forwarded-For and slip the per-IP rate limits.
TRUST_PROXY=0
# Comma-separated list of allowed browser origins. Empty = allow all (dev only).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/blogforge?retryWrites=true&w=majority

# --- Auth ---
# Use long random strings (>= 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Admin seeding (used by `npm run seed:admin`) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- AI service (Phase 3 - GenAI) ------------------------------------------
# Base URL of the FastAPI RAG microservice. Leave EMPTY to disable the /ai
# routes entirely - the rest of the API is unaffected.
AI_SERVICE_URL=http://127.0.0.1:8000
# Shared secret sent as X-AI-Service-Token. Must match AI_SERVICE_TOKEN in
# ai-service/.env. Required whenever AI_SERVICE_URL is set in production.
AI_SERVICE_TOKEN=
# Generation is slow; indexing runs detached and nobody waits on it.
AI_SERVICE_TIMEOUT_MS=60000
AI_INGEST_TIMEOUT_MS=120000
# Per-user budget on the endpoints that cost money. The daily number is the one
# that actually bounds a bill — 30/hour is 720/day if someone is patient.
AI_RATE_LIMIT_HOURLY=30
AI_RATE_LIMIT_DAILY=100
