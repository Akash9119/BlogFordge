# ---------------------------------------------------------------------------
# BlogForge AI service (Phase 3 - GenAI)
# Copy to .env and fill in. This service is internal: only the Node API calls it.
# ---------------------------------------------------------------------------

ENV=development
LOG_LEVEL=INFO

# Bind address used by `python main.py`. Loopback only — the Node API is the
# only caller. (`uvicorn main:app --port N` overrides this.)
AI_HOST=127.0.0.1
AI_PORT=8000

# --- Auth ------------------------------------------------------------------
# Shared secret Node sends as the X-AI-Service-Token header. Must match
# AI_SERVICE_TOKEN in Backend/.env. Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AI_SERVICE_TOKEN=

# --- Database --------------------------------------------------------------
# The SAME cluster and database as the Node API - one cluster, one `blogforge`
# DB. Vectors are written to the `embeddings` collection.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/blogforge?retryWrites=true&w=majority
# Optional: overrides the database in the URI.
MONGODB_DB=
EMBEDDINGS_COLLECTION=embeddings

# --- Vector search ---------------------------------------------------------
# auto   = use Atlas Vector Search when its index answers, else cosine in memory
# atlas  = require the Atlas index (fail loudly if it is missing)
# memory = always brute-force cosine (fine for a few thousand chunks)
VECTOR_SEARCH_MODE=auto
VECTOR_INDEX_NAME=blogforge_vector_index
MEMORY_SCAN_LIMIT=5000

# --- Models ----------------------------------------------------------------
# openai (default) or huggingface (needs the optional extras in requirements.txt)
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
# Point at any OpenAI-compatible server (Ollama, LM Studio, vLLM) to run local:
#   OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_BASE_URL=

EMBEDDING_MODEL=text-embedding-3-small
# Must match the model's output size - 1536 for text-embedding-3-small,
# 3072 for text-embedding-3-large, 384 for all-MiniLM-L6-v2.
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=64

CHAT_MODEL=gpt-4o-mini
CHAT_TEMPERATURE=0.2
CHAT_MAX_TOKENS=1200

# --- Chunking --------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Retrieval / prompt budget ---------------------------------------------
RETRIEVAL_TOP_K=6
RETRIEVAL_MAX_K=20
# Atlas-style cosine score in [0, 1]. Raise it to refuse weak matches.
RETRIEVAL_MIN_SCORE=0.0
MAX_CONTEXT_CHARS=12000
MAX_QUESTION_CHARS=1000
MAX_HISTORY_TURNS=6

# --- Guardrail: refuse off-topic questions before they cost a call ----------
# "How do I make tea?" still retrieves six chunks — top-k always returns
# something — so a question is judged off-topic when its best chunk scores below
# RELEVANCE_FLOOR *and* it uses none of the blog vocabulary in app/guardrails.py.
# Those questions are refused without calling the model, so they cost one
# embedding instead of a completion.
#
# Same 0–1 scale both search paths report, where 0.5 means unrelated. Every
# refusal logs the score it saw: watch the log, then tune. Raise it to refuse
# more, lower it if real questions are being turned away. 0 disables the score
# path entirely (vocabulary alone decides); GUARDRAIL_ENABLED=false turns the
# whole gate off and leaves only the system prompt.
GUARDRAIL_ENABLED=true
RELEVANCE_FLOOR=0.62
